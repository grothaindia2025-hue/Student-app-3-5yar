<title>Kids Reading Book</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial,sans-serif;
}

body{
  background:#e3f2fd;
}

header{
  background:#2196f3;
  color:#fff;
  text-align:center;
  padding:18px;
  font-size:30px;
  font-weight:bold;
}

.grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:15px;
  padding:15px;
}

.card{
  background:white;
  min-height:95px;
  border-radius:18px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  font-size:24px;
  font-weight:bold;
  box-shadow:0 6px 14px rgba(0,0,0,.15);
  cursor:pointer;
  padding:12px;
  line-height:1.35;
  transition:transform .2s, box-shadow .2s;
}

.card:active{
  transform:scale(.96);
}

.page{
  display:none;
  padding:15px;
}

.pageWrap{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin-top:15px;
}

.pageTitle{
  font-size:28px;
  font-weight:bold;
  margin:15px 0;
  text-align:center;
  color:#1565c0;
}

.backBtn{
  padding:10px 18px;
  font-size:18px;
  border:none;
  border-radius:12px;
  background:#2196f3;
  color:white;
  margin-bottom:10px;
  cursor:pointer;
}

.learnCard{
  background:white;
  min-height:120px;
  border-radius:18px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:10px;
  font-size:22px;
  font-weight:bold;
  box-shadow:0 5px 12px rgba(0,0,0,.12);
  transition:.2s;
  cursor:pointer;
  animation:popIn .35s ease;
}

.learnCard:active{
  transform:scale(.96);
}

.learnCard .emoji{
  font-size:40px;
  margin-bottom:8px;
}

.learnCard .small{
  font-size:18px;
  font-weight:normal;
}

.quizResult{
  margin-top:8px;
  font-size:20px;
  text-align:center;
}

@keyframes popIn{
  0%{transform:scale(.7);opacity:0;}
  100%{transform:scale(1);opacity:1;}
}
</style>
</head>
