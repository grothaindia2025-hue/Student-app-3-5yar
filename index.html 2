  <div class="pageWrap" style="margin-top:15px;">
    <div class="learnCard" id="opt1">🍎 Apple</div>
    <div class="learnCard" id="opt2">⚽ Ball</div>
    <div class="learnCard" id="opt3">🐱 Cat</div>
    <div class="learnCard" id="opt4">🐶 Dog</div>
  </div>

  <div class="learnCard" style="margin-top:18px;background:#e8f5e9;">
    <div style="font-size:24px;">⭐ Score: <span id="score">0</span></div>
    <div id="quizResult" class="quizResult">Tap an answer</div>
  </div>

  <div style="text-align:center;margin-top:15px;">
    <button class="backBtn" onclick="nextQuestion()">➡ Next Question</button>
  </div>
</div>

<!-- REWARD PAGE -->
<div id="rewardPage" class="page">
  <button class="backBtn" onclick="goHome()">⬅ Back</button>
  <div class="pageTitle">🏆 Rewards</div>

  <div class="learnCard" style="min-height:140px;">
    ⭐ Stars Earned
    <div style="font-size:28px;margin-top:10px;" id="starCount">0 ⭐</div>
  </div>

  <div class="learnCard" style="margin-top:15px;">
    🎖️ Keep Learning Every Day
  </div>
</div>

<script>
function hideAllPages(){
  document.getElementById("abcPage").style.display="none";
  document.getElementById("hindiPage").style.display="none";
  document.getElementById("numberPage").style.display="none";
  document.getElementById("colorPage").style.display="none";
  document.getElementById("animalPage").style.display="none";
  document.getElementById("fruitPage").style.display="none";
  document.getElementById("quizPage").style.display="none";
  document.getElementById("rewardPage").style.display="none";
}

function goHome(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="grid";
}

function openABC(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("abcPage").style.display="block";
}

function openHindi(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("hindiPage").style.display="block";
}

function openNumber(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("numberPage").style.display="block";
}

function openColor(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("colorPage").style.display="block";
}

function openAnimals(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("animalPage").style.display="block";
}

function openFruit(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("fruitPage").style.display="block";
}

function openReward(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("rewardPage").style.display="block";
}

function speak(text){
  if(!window.speechSynthesis){
    alert("Speech not supported in this browser");
    return;
  }
  speechSynthesis.cancel();
  let msg = new SpeechSynthesisUtterance(text);
  msg.lang = "en-IN";
  msg.rate = 0.9;
  msg.pitch = 1;
  msg.volume = 1;
  speechSynthesis.speak(msg);
}

let stars = 0;
function addStar(){
  stars++;
  document.getElementById("starCount").innerText = stars + " ⭐";
}

/* QUIZ */
let quizData = [
  {
    question: "A for ?",
    options: ["Apple","Ball","Cat","Dog"],
    icons: ["🍎","⚽","🐱","🐶"],
    answer: "Apple"
  },
  {
    question: "B for ?",
    options: ["Lion","Ball","Fish","Goat"],
    icons: ["🦁","⚽","🐟","🐐"],
    answer: "Ball"
  },
  {
    question: "C for ?",
    options: ["Cat","Dog","Apple","Sun"],
    icons: ["🐱","🐶","🍎","☀️"],
    answer: "Cat"
  },
  {
    question: "D for ?",
    options: ["Tiger","Dog","Hen","Cow"],
    icons: ["🐯","🐶","🐔","🐄"],
    answer: "Dog"
  },
  {
    question: "Which fruit is Mango?",
    options: ["Apple","Mango","Banana","Orange"],
    icons: ["🍎","🥭","🍌","🍊"],
    answer: "Mango"
  }
];

let currentQuiz = 0;
let score = 0;
let answered = false;

function openQuiz(){
  hideAllPages();
  document.getElementById("homeGrid").style.display="none";
  document.getElementById("quizPage").style.display="block";

  currentQuiz = 0;
  score = 0;
  answered = false;

  document.getElementById("score").innerText = score;
  document.getElementById("opt1").style.display="flex";
  document.getElementById("opt2").style.display="flex";
  document.getElementById("opt3").style.display="flex";
  document.getElementById("opt4").style.display="flex";

  loadQuestion();
}

function loadQuestion(){
  let q = quizData[currentQuiz];
  answered = false;

  document.getElementById("quizQuestion").innerText = q.question;
  document.getElementById("opt1").innerHTML = q.icons[0] + "<br>" + q.options[0];
  document.getElementById("opt2").innerHTML = q.icons[1] + "<br>" + q.options[1];
  document.getElementById("opt3").innerHTML = q.icons[2] + "<br>" + q.options[2];
  document.getElementById("opt4").innerHTML = q.icons[3] + "<br>" + q.options[3];

  document.getElementById("opt1").onclick = function(){ checkAnswer(q.options[0]); };
  document.getElementById("opt2").onclick = function(){ checkAnswer(q.options[1]); };
  document.getElementById("opt3").onclick = function(){ checkAnswer(q.options[2]); };
  document.getElementById("opt4").onclick = function(){ checkAnswer(q.options[3]); };

  document.getElementById("quizResult").innerText = "Tap an answer";
}

function checkAnswer(ans){
  if(answered) return;
  answered = true;

  let q = quizData[currentQuiz];

  if(ans === q.answer){
    score++;
    document.getElementById("score").innerText = score;
    document.getElementById("quizResult").innerText = "✅ Correct!";
    speak("Correct answer");
    addStar();
  }else{
    document.getElementById("quizResult").innerText = "❌ Wrong! सही उत्तर है " + q.answer;
    speak("Wrong answer");
  }
}

function nextQuestion(){
  if(!answered){
    document.getElementById("quizResult").innerText = "पहले answer चुनो";
    return;
  }

  currentQuiz++;

  if(currentQuiz >= quizData.length){
    document.getElementById("quizQuestion").innerText = "🎉 Quiz Finished!";
    document.getElementById("opt1").style.display = "none";
    document.getElementById("opt2").style.display = "none";
    document.getElementById("opt3").style.display = "none";
    document.getElementById("opt4").style.display = "none";
    document.getElementById("quizResult").innerText = "Your final score is " + score;
    speak("Quiz finished. Your score is " + score);
    return;
  }

  loadQuestion();
}
</script>

</body>
</html>